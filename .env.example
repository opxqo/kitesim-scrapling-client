# Copy these names into the ignored local .env or EdgeOne environment settings.
# Never commit real account credentials, generated keys, or runtime Tokens.

# Configure 1-20 login accounts. All configured accounts use the shared password.
KITESIM_LOGIN_EMAIL_1=first_account@example.com
KITESIM_LOGIN_EMAIL_2=second_account@example.com
KITESIM_LOGIN_EMAIL_3=third_account@example.com
KITESIM_LOGIN_PASSWORD=replace_with_the_shared_kitesim_password

# Generated Tokens are encrypted per account in the private kitesim-auth Blob store.
# Generate once with: openssl rand -base64 32
KITESIM_AUTH_ENCRYPTION_KEY=replace_with_base64_32_byte_key
# Generate once with: openssl rand -hex 32
KITESIM_AUTH_BRIDGE_SECRET=replace_with_random_internal_signature_secret

# AI vision reads only the CAPTCHA image. Keep the gateway key server-side.
# Use KITESIM_AI_* to avoid EdgeOne's auto-filled AI_GATEWAY_* pair.
KITESIM_AUTH_AUTOMATION_ENABLED=true
KITESIM_AI_BASE_URL=https://ai.opxqo.com/compat/v1
KITESIM_AI_API_KEY=replace_with_ai_gateway_api_key
KITESIM_AI_MODEL=google-ai-studio/gemini-3.1-flash-lite-preview
# Optional safety bounds: 1-3 attempts and a 6-168 hour success cooldown.
KITESIM_AUTH_MAX_CAPTCHA_ATTEMPTS=3
KITESIM_AUTH_MAINTENANCE_INTERVAL_HOURS=20
KITESIM_AI_TIMEOUT_SECONDS=12

# Independent dashboard access secret; do not reuse the Kitesim password.
DASHBOARD_ACCESS_KEY=replace_with_a_random_value_of_at_least_12_characters
KITESIM_REQUEST_TIMEOUT=12

# New orders/SMS snapshots are versioned plaintext JSON in private EdgeOne Blob storage.
# Keep this optional migration key only while old encrypted snapshots still need reading.
SMS_CACHE_ENCRYPTION_KEY=
# Freshness marker only; stale snapshots remain readable and never auto-refresh.
SMS_CACHE_TTL_SECONDS=20
