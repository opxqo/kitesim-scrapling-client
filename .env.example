# Copy these names into the local shell or EdgeOne environment settings.
# Never commit real values.
# EdgeOne-safe multi-account format: one Token per environment variable.
KITESIM_TOKEN_1=replace_with_first_kitesim_token
KITESIM_TOKEN_NAME_1=主号码
KITESIM_TOKEN_2=replace_with_second_kitesim_token
KITESIM_TOKEN_NAME_2=备用号码
# Optional local shorthand. Keep the JSON inside single quotes when sourced by a shell.
KITESIM_TOKENS=
# Backward-compatible single account.
KITESIM_TOKEN=
DASHBOARD_ACCESS_KEY=replace_with_a_random_value_of_at_least_12_characters
KITESIM_REQUEST_TIMEOUT=12
# Optional EdgeOne half-automatic login. These credentials remain server-side.
KITESIM_LOGIN_EMAIL=replace_with_kitesim_login_email
KITESIM_LOGIN_PASSWORD=replace_with_kitesim_login_password
# Generate once with: openssl rand -base64 32
KITESIM_AUTH_ENCRYPTION_KEY=replace_with_base64_32_byte_key
# Generate once with: openssl rand -hex 32
KITESIM_AUTH_BRIDGE_SECRET=replace_with_random_internal_signature_secret
# New orders/SMS snapshots are versioned plaintext JSON in private EdgeOne Blob storage.
# Optional migration key: keep the previous Base64 AES-256-GCM key only while old
# encrypted snapshots still need to be read. A successful manual refresh rewrites
# that snapshot as plaintext JSON, so new deployments should leave this empty.
SMS_CACHE_ENCRYPTION_KEY=
# Freshness marker only; stale snapshots remain readable and never auto-refresh.
# Values outside 5-300 seconds are clamped into that range.
SMS_CACHE_TTL_SECONDS=20
